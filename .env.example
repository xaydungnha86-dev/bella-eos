# ─────────────────────────────────────────────────────────────────
# BELLA EOS — Environment Variables Template
# Copy this file to ".env.local" and fill in real values.
# ".env.local" is in .gitignore — NEVER commit real secrets to Git.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Service Role key (server-side only — never use NEXT_PUBLIC_ prefix for this)
# Get from: Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ── Facebook Graph API ─────────────────────────────────────────────
# Get from: https://developers.facebook.com → Your App → Access Tokens
# Loại token cần: "Page Access Token" với quyền pages_manage_posts
FACEBOOK_PAGE_ACCESS_TOKEN=EAAG...your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=me

# ── OpenAI API (để Claude/GPT-4o gọi thật) ────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ── Anthropic Claude API ───────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ── Next.js App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=production

# ── Creative Intelligence Engine v3 ─────────────────────────────────
# Enable AI-powered creative reasoning (Layer 2: LLM-based Creative Director)
# Values: "v3" (enable) | undefined (use v2 template-based)
# Rollback: Comment out this line to instantly revert to v2
CREATIVE_INTELLIGENCE_VERSION=v3

# ── Google Gemini API (for Creative Reasoning) ──────────────────────
# Get from: https://makersuite.google.com/app/apikey
# Used by Creative Director Agent (Layer 2) for creative brief generation
# Fallback: If missing, uses rule-based generation (0.75 confidence vs 0.95)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ── FAL.AI API (for Flux.1 Image Generation) ───────────────────────
# Get from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here
